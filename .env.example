# --- Core -------------------------------------------------------------
PORT=3000
# Your public address, e.g. https://gamepact.app (used for CORS/origin checks)
PUBLIC_URL=
# Postgres connection string. Leave empty to use the embedded database in DATA_DIR
# (fine for a single small server; use real Postgres in production).
DATABASE_URL=
DATA_DIR=./data/pglite
# Number of proxies in front of the app (Render/Railway/Fly = 1)
TRUST_PROXY=1
# Comma-separated usernames that get the admin dashboard (/admin)
ADMIN_USERNAMES=
PASSWORD_MIN_LENGTH=12
REGISTER_PER_HOUR=30
SESSION_DAYS=30

# --- Ads ----------------------------------------------------------------
# Ads stay off until BOTH a provider is configured AND the community reaches
# ADS_USER_THRESHOLD active accounts (or ADS_MODE=on). Fill these in whenever
# you like — nothing shows until the threshold is crossed.
# adsense | (empty = none)
ADS_PROVIDER=
# ca-pub-XXXXXXXXXXXXXXXX
ADS_CLIENT_ID=
# display ad unit id for the home page
ADS_SLOT_BANNER=
# display ad unit id under the match result screen
ADS_SLOT_RESULTS=
# display ad unit id on tournaments / leaderboards
ADS_SLOT_SIDEBAR=
ADS_USER_THRESHOLD=2000
# auto | on | off
ADS_MODE=auto
# true once Google approves you for H5 Games Ads (between-match breaks)
ADS_H5_INTERSTITIAL=false
# true = Google test ads, no real impressions
ADS_TEST_MODE=false
